{
  "name": "eco-ai-teacher-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "GLOBAL_AI_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "CLIENT_AI_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
