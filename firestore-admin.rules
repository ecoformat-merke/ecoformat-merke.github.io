rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == 'active';
    }
    // Only the founding, verified Google account may appoint another administrator.
    function isOwnerAdmin() {
      return isAdmin() && googleVerified()
        && request.auth.token.email == 'gulyantsdanil@gmail.com';
    }
    function googleVerified() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    match /profiles/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if owner(uid) && googleVerified()
        && request.resource.data.keys().hasOnly(['uid','displayName','email','requestedRole','requestedClass','role','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','displayName','email','requestedRole','requestedClass','role','status','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.requestedRole in ['student','teacher']
        && request.resource.data.requestedClass is string
        && request.resource.data.requestedClass.size() <= 20
        && request.resource.data.role == 'visitor'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin() && request.auth.uid != uid
        && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
        && (
           (request.resource.data.status == 'active'
             && (request.resource.data.role == resource.data.requestedRole
                 || (request.resource.data.role == 'leader' && resource.data.requestedRole == 'teacher')))
           || (request.resource.data.status in ['pending','blocked']
               && request.resource.data.role == 'visitor')
        );
      // Distinct owner-only operation; ordinary admins cannot create admins.
      allow update: if isOwnerAdmin()
        && request.auth.uid != uid
        && resource.data.role in ['visitor', 'teacher']
        && resource.data.requestedRole == 'teacher'
        && resource.data.status in ['pending', 'active']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'active';
      allow delete: if false;
    }
    // Personal teacher drafts, separate from the published GAS event registry.
    match /profiles/{uid}/teacherDrafts/{draftId} {
      function canDraft() {
        return owner(uid)
          && get(/databases/$(database)/documents/profiles/$(uid)).data.status == 'active'
          && get(/databases/$(database)/documents/profiles/$(uid)).data.role in ['teacher','leader','admin'];
      }
      function validDraft() {
        return request.resource.data.keys().hasOnly([
          'ownerUid','status','createdAt','updatedAt',
          'nameRu','nameKz','descRu','descKz','projectId',
          'category','className','eventDate','instagram'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','status','createdAt','updatedAt',
          'nameRu','nameKz','descRu','descKz','projectId',
          'category','className','eventDate','instagram'
        ])
        && request.resource.data.ownerUid == uid
        && request.resource.data.status == 'draft'
        && request.resource.data.nameRu is string
        && request.resource.data.nameRu.size() > 0
        && request.resource.data.nameRu.size() <= 160
        && request.resource.data.nameKz is string
        && request.resource.data.nameKz.size() > 0
        && request.resource.data.nameKz.size() <= 160
        && request.resource.data.descRu is string
        && request.resource.data.descRu.size() > 0
        && request.resource.data.descRu.size() <= 1800
        && request.resource.data.descKz is string
        && request.resource.data.descKz.size() > 0
        && request.resource.data.descKz.size() <= 1800
        && request.resource.data.projectId in ['1','2','3','4','5','6']
        && request.resource.data.category in ['education','upbringing','activity']
        && request.resource.data.className is string
        && request.resource.data.className.size() > 0
        && request.resource.data.className.size() <= 80
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.size() == 10
        && request.resource.data.instagram is string
        && request.resource.data.instagram.size() <= 400
        && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if canDraft();
      allow create: if canDraft() && validDraft()
        && request.resource.data.createdAt == request.time;
      allow update: if canDraft() && validDraft()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nameRu','nameKz','descRu','descKz','projectId',
          'category','className','eventDate','instagram','updatedAt'
        ]);
      allow delete: if canDraft();
    }
    match /siteContent/{docId} {
      allow get: if docId == 'home';
      allow list: if false;
      allow create, update: if docId == 'home' && isAdmin()
        && request.resource.data.keys().hasOnly(['titleRu','titleKz','bodyRu','bodyKz','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['titleRu','titleKz','bodyRu','bodyKz','updatedAt','updatedBy'])
        && request.resource.data.titleRu is string
        && request.resource.data.titleRu.size() <= 110
        && request.resource.data.titleKz is string
        && request.resource.data.titleKz.size() <= 110
        && request.resource.data.bodyRu is string
        && request.resource.data.bodyRu.size() <= 1200
        && request.resource.data.bodyKz is string
        && request.resource.data.bodyKz.size() <= 1200
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /roleAudit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','action','oldRole','newRole','oldStatus','newStatus','at'])
        && request.resource.data.keys().hasAll(['actorUid','targetUid','action','oldRole','newRole','oldStatus','newStatus','at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && (
          (request.resource.data.action in ['approve','block','pending']
           && request.resource.data.newRole in ['visitor','student','teacher','leader']
           && request.resource.data.newStatus in ['active','blocked','pending'])
          ||
          (request.resource.data.action == 'promote-admin'
           && isOwnerAdmin()
           && request.resource.data.newRole == 'admin'
           && request.resource.data.newStatus == 'active')
        )
        && request.resource.data.oldRole is string
        && request.resource.data.oldStatus is string
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}